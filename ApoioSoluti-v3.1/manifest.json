{
  "manifest_version": 3,
  "name": "Apoio Soluti",
  "version": "5.0",
  "version_name": "5.0 beta",
  "description": "Macros, extrator de texto da tela, consultas de AR e atalhos para atendimento.",
  "permissions": [
    "storage",
    "offscreen",
    "scripting",
    "contextMenus",
    "alarms",
    "tabs",
    "cookies",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/dados/macros-equipe.js",
        "src/comum/macros.js",
        "src/content/content.js",
        "src/content/visualizador.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://*.acsoluti.com.br/*"],
      "js": ["src/content/gridlocalizar.js"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "extrair-texto": {
      "suggested_key": {
        "default": "Ctrl+M"
      },
      "description": "Extrair texto da tela"
    },
    "abrir-solicitacao": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "Abrir solicitação na AR (código selecionado)"
    },
    "comecar-o-dia": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Abrir os sistemas do atendimento"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
